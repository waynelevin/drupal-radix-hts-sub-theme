<?php

/**
 * @file
 * Font setting: loads a Google Font and applies it to body text and headings.
 */

use Drupal\Core\Render\Markup;

/**
 * Font options.
 *
 * Each option is [label, Google Fonts css2 family spec or NULL, CSS stack].
 * The empty key keeps the font of the selected Bootswatch theme.
 *
 * @return array<string, array{0: string, 1: ?string, 2: ?string}>
 *   The options, keyed by machine name.
 */
function hts_font_options(): array {
  $sans = ', system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif';
  $serif = ', Georgia, Cambria, "Times New Roman", Times, serif';
  $static = [100, 200, 300, 400, 500, 600, 700, 800, 900];

  // Every weight each family offers. A "min..max" range is for variable fonts;
  // a list is for families that only ship static weights. The browser
  // downloads only the weights the page actually uses.
  return [
    '' => ['Theme default', NULL, NULL],
    'system' => ['System UI (no web font)', NULL, 'system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", Arial, sans-serif'],
    // Sans-serif.
    'inter' => ['Inter', hts_font_spec('Inter', '100..900'), '"Inter"' . $sans],
    'roboto' => ['Roboto', hts_font_spec('Roboto', '100..900'), '"Roboto"' . $sans],
    'open-sans' => ['Open Sans', hts_font_spec('Open Sans', '300..800'), '"Open Sans"' . $sans],
    'lato' => ['Lato', hts_font_spec('Lato', [100, 300, 400, 700, 900]), '"Lato"' . $sans],
    'montserrat' => ['Montserrat', hts_font_spec('Montserrat', '100..900'), '"Montserrat"' . $sans],
    'poppins' => ['Poppins', hts_font_spec('Poppins', $static), '"Poppins"' . $sans],
    'source-sans-3' => ['Source Sans 3', hts_font_spec('Source Sans 3', '200..900'), '"Source Sans 3"' . $sans],
    'nunito' => ['Nunito', hts_font_spec('Nunito', '200..1000'), '"Nunito"' . $sans],
    'raleway' => ['Raleway', hts_font_spec('Raleway', '100..900'), '"Raleway"' . $sans],
    'work-sans' => ['Work Sans', hts_font_spec('Work Sans', '100..900'), '"Work Sans"' . $sans],
    'dm-sans' => ['DM Sans', hts_font_spec('DM Sans', '100..1000'), '"DM Sans"' . $sans],
    'ibm-plex-sans' => ['IBM Plex Sans', hts_font_spec('IBM Plex Sans', '100..700'), '"IBM Plex Sans"' . $sans],
    'fira-sans' => ['Fira Sans', hts_font_spec('Fira Sans', $static), '"Fira Sans"' . $sans],
    'manrope' => ['Manrope', hts_font_spec('Manrope', '200..800', FALSE), '"Manrope"' . $sans],
    'outfit' => ['Outfit', hts_font_spec('Outfit', '100..900', FALSE), '"Outfit"' . $sans],
    // Serif.
    'merriweather' => ['Merriweather (serif)', hts_font_spec('Merriweather', '300..900'), '"Merriweather"' . $serif],
    'lora' => ['Lora (serif)', hts_font_spec('Lora', '400..700'), '"Lora"' . $serif],
    'playfair-display' => ['Playfair Display (serif)', hts_font_spec('Playfair Display', '400..900'), '"Playfair Display"' . $serif],
    'pt-serif' => ['PT Serif (serif)', hts_font_spec('PT Serif', [400, 700]), '"PT Serif"' . $serif],
    'roboto-slab' => ['Roboto Slab (serif)', hts_font_spec('Roboto Slab', '100..900', FALSE), '"Roboto Slab"' . $serif],
  ];
}

/**
 * Builds a Google Fonts css2 family spec.
 *
 * @param string $family
 *   The family name, eg "Open Sans".
 * @param string|int[] $weights
 *   A "min..max" range for a variable font, or a list of static weights.
 * @param bool $italic
 *   Whether the family has italics.
 *
 * @return string
 *   The spec, eg "Open+Sans:ital,wght@0,300..800;1,300..800".
 */
function hts_font_spec(string $family, string|array $weights, bool $italic = TRUE): string {
  $weights = (array) $weights;
  $family = str_replace(' ', '+', $family);
  if (!$italic) {
    return "$family:wght@" . implode(';', $weights);
  }
  $tuples = array_merge(
    array_map(fn($w) => "0,$w", $weights),
    array_map(fn($w) => "1,$w", $weights),
  );
  return "$family:ital,wght@" . implode(';', $tuples);
}

/**
 * Attaches the selected font's stylesheet and CSS to the page.
 *
 * Called from hts_page_attachments_alter().
 */
function hts_font_page_attachments(array &$attachments): void {
  $options = hts_font_options();
  $font = (string) theme_get_setting('font', 'hts');
  if ($font === '' || !isset($options[$font])) {
    return;
  }
  [, $google, $stack] = $options[$font];

  if ($google !== NULL) {
    $attachments['#attached']['html_head'][] = [[
      '#tag' => 'link',
      '#attributes' => ['rel' => 'preconnect', 'href' => 'https://fonts.googleapis.com'],
    ], 'hts_font_preconnect'];
    $attachments['#attached']['html_head'][] = [[
      '#tag' => 'link',
      '#attributes' => ['rel' => 'preconnect', 'href' => 'https://fonts.gstatic.com', 'crossorigin' => 'anonymous'],
    ], 'hts_font_preconnect_static'];
    $attachments['#attached']['html_head'][] = [[
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'stylesheet',
        'href' => 'https://fonts.googleapis.com/css2?family=' . $google . '&display=swap',
      ],
    ], 'hts_font_stylesheet'];
  }

  // Bootstrap reads the body font from --bs-body-font-family; some Bootswatch
  // themes give headings and the navbar brand their own font, so set those too.
  // Drupal prints this <style> before the theme stylesheets, so every selector
  // is prefixed with "html" to outrank the Bootswatch rules (eg Zephyr's
  // ":root { --bs-font-sans-serif: Inter }") regardless of order.
  $elements = ['body', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', '.h1', '.h2', '.h3', '.h4', '.h5', '.h6', '.display-1', '.display-2', '.display-3', '.display-4', '.display-5', '.display-6', '.navbar', '.navbar-brand', '.btn'];
  $selectors = implode(',', array_map(fn(string $selector) => "html $selector", $elements));
  $attachments['#attached']['html_head'][] = [[
    '#tag' => 'style',
    '#value' => Markup::create('html:root,html [data-bs-theme]{--bs-body-font-family:' . $stack . ';--bs-font-sans-serif:' . $stack . ';}'
      . $selectors . '{font-family:var(--bs-body-font-family);}'),
  ], 'hts_font_css'];
}
